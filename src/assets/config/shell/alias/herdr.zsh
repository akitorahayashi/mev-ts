alias hd="herdr"
alias hd-st="herdr status"

# server
alias hd-rel="herdr server reload-config"
alias hd-s-s="herdr server stop"

# session
alias hd-s="herdr session"
alias hd-s-a="herdr session attach"
alias hd-s-st="herdr session stop"
alias hd-s-d="herdr session delete"
alias hd-s-ls="herdr session list"

# workspace
alias hd-w="herdr workspace"
alias hd-w-ls="herdr workspace list"
alias hd-w-cr="herdr workspace create"
alias hd-w-cr-l="herdr workspace create --label"
